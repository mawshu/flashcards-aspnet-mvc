@model SergeevaMaria_Lab6_V2_1.Models.Card
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Добавить карточку";
}

<h2>Добавить карточку</h2>

@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
{
        <p style="color:red;">@error.ErrorMessage</p>
}

<form asp-action="Add" method="post">
    <label>Слово: <input asp-for="Word" /></label><br/>
    <label>Перевод: <input asp-for="Translation" /></label><br/>
    <label>Категория:
        <select asp-for="CategoryId" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Title"))"></select>
    </label><br/>
    <input type="submit" value="Добавить" />
</form>

<a href="/">На главную</a>
